# --- Portfolio & CMS Configuration ---

# 🌐 Backend API URL
# Production: Use '/api' if hosted on the same domain as the frontend
# Local Development: Point to your local PHP server (e.g., http://localhost:8080/api)
VITE_API_URL=/api

# 🔗 Portfolio Site URL
# The public URL where your portfolio will be accessible
VITE_SITE_URL=https://yourportfolio.com

# --- 📤 Hostinger Deployment (FTP) ---
# Your FTP host (e.g., ftp.yourportfolio.com)
FTP_HOST=ftp.yourportfolio.com
# Your FTP username
FTP_USER=your_ftp_username
# Your FTP password
FTP_PASSWORD=your_ftp_password
# The remote directory where the site should be uploaded (usually /public_html)
FTP_REMOTE_PATH=/public_html

# --- ✉️ EmailJS (Optional) ---
# Used for the Contact Form
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_USER_ID=your_user_id
