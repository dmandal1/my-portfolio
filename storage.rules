rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null;
    }

    // Blog cover images — admin write, public read
    match /blog-covers/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Portfolio asset uploads (logos, project images, etc.) — admin write, public read
    match /portfolio-assets/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
