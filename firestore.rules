rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null;
    }

    function isValidCommentPayload() {
      return request.resource.data.keys().hasOnly(['name', 'message', 'createdAt', 'parentId', 'isAuthorReply'])
        && request.resource.data.name is string
        && request.resource.data.message is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && (!('parentId' in request.resource.data) || request.resource.data.parentId is string)
        && (!('isAuthorReply' in request.resource.data) || request.resource.data.isAuthorReply is bool);
    }

    match /categories/{catId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /adminPanelSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /authorFollowers/{clientId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['following', 'updatedAt', 'device'])
        && request.resource.data.following is bool;
      allow delete: if true;
    }

    match /blogs/{blogId} {
      // Public can read published posts; signed-in admins can manage all posts.
      allow read: if isAdmin() || resource.data.published == true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['views', 'commentsCount', 'updatedAt'])
          && request.resource.data.views == resource.data.views + 1
          && request.resource.data.commentsCount == resource.data.commentsCount
        )
        || (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['commentsCount', 'updatedAt'])
          && request.resource.data.commentsCount == resource.data.commentsCount + 1
          && request.resource.data.views == resource.data.views
        );

      match /comments/{commentId} {
        // Public comments are readable by everyone.
        allow read: if true;
        allow create: if isAdmin() || isValidCommentPayload();

        // Only signed-in admins can edit or delete comments.
        allow update, delete: if isAdmin();

      }

      match /ratings/{clientId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['value', 'updatedAt'])
          && request.resource.data.value is number
          && request.resource.data.value >= 1
          && request.resource.data.value <= 5;
        allow delete: if true;
      }
    }

    match /portfolioCertifications/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioExperiences/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioProfile/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioContact/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioSeo/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioSocialLinks/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioEducation/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioCompetitiveSites/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioProjects/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioSkills/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioExperienceHeader/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioContactPageData/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioProjectsHeader/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /authorRatings/{clientId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['value', 'updatedAt', 'device'])
        && request.resource.data.value is number
        && request.resource.data.value >= 1
        && request.resource.data.value <= 5;
      allow delete: if true;
    }

    // Allow collectionGroup queries on "comments" (e.g. admin recent comments feed).
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }
  }
}
