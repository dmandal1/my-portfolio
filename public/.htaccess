DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. If the requested file or directory exists physically, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Never serve index.html for missing static assets (prevents MIME type text/html errors)
  RewriteCond %{REQUEST_URI} \.(css|js|mjs|png|jpe?g|gif|svg|woff2?|ttf|eot|mp4|webm|ico|json|map)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 3. Allow access to backend PHP API
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # 4. Route remaining client-side SPA navigation routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>
